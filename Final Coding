/* ================= L298N (2 motors at the back) ================= */
#define IN1 14
#define IN2 27
#define IN3 26
#define IN4 25

#define ENA 33   // LEFT motor speed
#define ENB 32   // RIGHT motor speed

/* ================= IR LINE SENSORS ================= */
#define LEFT_SENSOR 34
#define RIGHT_SENSOR 35

/* ================= SG90 SERVO ================= */
#define SERVO_PIN 18

/* ================= PWM ================= */
const int pwmFreq = 1000;
const int pwmResolution = 8;

const int servoFreq = 50;
const int servoResolution = 16;

/* ================= P CONTROL ================= */
float Kp = 60;
float error = 0;

/* ================= SPEED ================= */
int baseSpeed = 150;

/* ================================================= */
/*               MOTOR CALIBRATION (TRIM)            */
/* ================================================= */
// Values are PERCENT (100 = full speed). Lower the FASTER motor.
//   Robot curves RIGHT -> left motor is faster  -> lower leftTrim
//   Robot curves LEFT  -> right motor is faster -> lower rightTrim
// Tune from the web page, then copy the final numbers from the
// Serial Monitor into these two lines.
float leftTrim  = 75;    // percent of the range ABOVE the minimum PWM
float rightTrim = 100;

// Minimum PWM at which each motor just starts to turn (deadband).
// Find them with the "TEST LEFT ONLY / RIGHT ONLY" buttons on the web page:
// lower the Motor Speed slider until that wheel barely moves, use that value.
int leftMin  = 60;
int rightMin = 60;

/* ================= MODE ================= */
bool runRobot = false;
bool manualMode = false;

/* ================= MANUAL COMMAND ================= */
bool forwardCmd = false;
bool backCmd = false;
bool leftCmd = false;
bool rightCmd = false;

/* ================= SERVO DATA ================= */
int servoAngle = 90;

/* ================= FORWARD TEST ================= */
unsigned long testEndTime = 0;
bool testRunning = false;
int testSide = 0;             // 0 = both motors (compensated), 1 = left raw, 2 = right raw


/* ================================================= */
/*                  MOTOR CONTROL                    */
/* ================================================= */

// Option 3: start at the motor's minimum PWM, then scale the rest by trim.
// speed is 0-255 (always positive here), returns the real PWM for that motor.
int compensate(int speed, int minPwm, float trim) {
  if (speed <= 0) return 0;
  float range = 255 - minPwm;
  int pwm = minPwm + (speed * range / 255.0) * trim / 100.0;
  return constrain(pwm, 0, 255);
}

// Raw drive for finding the minimum PWM (NO compensation), forward only.
// side: 1 = left motor only, 2 = right motor only
void rawSingleMotor(int side, int pwm) {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
  ledcWrite(ENA, side == 1 ? pwm : 0);
  ledcWrite(ENB, side == 2 ? pwm : 0);
}

void motorControl(int leftSpeed, int rightSpeed) {

  leftSpeed = constrain(leftSpeed, -255, 255);
  rightSpeed = constrain(rightSpeed, -255, 255);

  /* ---------- LEFT MOTOR DIRECTION ---------- */
  if (leftSpeed >= 0) {
    digitalWrite(IN1, HIGH);
    digitalWrite(IN2, LOW);
  } else {
    digitalWrite(IN1, LOW);
    digitalWrite(IN2, HIGH);
    leftSpeed = -leftSpeed;
  }

  /* ---------- RIGHT MOTOR DIRECTION ---------- */
  if (rightSpeed >= 0) {
    digitalWrite(IN3, HIGH);
    digitalWrite(IN4, LOW);
  } else {
    digitalWrite(IN3, LOW);
    digitalWrite(IN4, HIGH);
    rightSpeed = -rightSpeed;
  }

  /* ---------- CALIBRATION (manual + line follow + test) ---------- */
  int leftPwm  = compensate(leftSpeed,  leftMin,  leftTrim);
  int rightPwm = compensate(rightSpeed, rightMin, rightTrim);

  ledcWrite(ENA, leftPwm);
  ledcWrite(ENB, rightPwm);
}

void stopMotors() {
  ledcWrite(ENA, 0);
  ledcWrite(ENB, 0);
}

void clearCommands() {
  forwardCmd = false;
  backCmd = false;
  leftCmd = false;
  rightCmd = false;
}

void handleManual() {
  if (forwardCmd) {
    motorControl(baseSpeed, baseSpeed);
  } else if (backCmd) {
    motorControl(-baseSpeed, -baseSpeed);
  } else if (leftCmd) {
    motorControl(-baseSpeed, baseSpeed);
  } else if (rightCmd) {
    motorControl(baseSpeed, -baseSpeed);
  } else {
    stopMotors();
  }
}


/* ================================================= */
/*                  SERVO CONTROL                    */
/* ================================================= */

void setServoAngle(int angle) {
  angle = constrain(angle, 0, 180);
  servoAngle = angle;

  // SG90: 0 deg = 0.5 ms, 180 deg = 2.4 ms
  int pulseUs = map(angle, 0, 180, 500, 2400);
  int duty = (pulseUs * 65535L) / 20000;

  ledcWrite(SERVO_PIN, duty);
}


