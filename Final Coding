/* ================================================= */
/*                       SETUP                       */
/* ================================================= */

void setup() {

  Serial.begin(115200);

  /* ---------- MOTOR PINS ---------- */
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);

  /* ---------- IR SENSOR PINS ---------- */
  pinMode(LEFT_SENSOR, INPUT);
  pinMode(RIGHT_SENSOR, INPUT);

  /* ---------- PWM - ESP32 CORE 3.x ---------- */
  ledcAttach(ENA, pwmFreq, pwmResolution);
  ledcAttach(ENB, pwmFreq, pwmResolution);

  /* ---------- SERVO PWM (50 Hz) ---------- */
  ledcAttach(SERVO_PIN, servoFreq, servoResolution);
  setServoAngle(servoAngle);

  /* ---------- SAFETY: keep trim in a sensible range ---------- */
  leftTrim  = constrain(leftTrim,  40, 100);
  rightTrim = constrain(rightTrim, 40, 100);
  leftMin   = constrain(leftMin,   0, 150);
  rightMin  = constrain(rightMin,  0, 150);

  /* ---------- WIFI ---------- */
  WiFi.softAP(ssid, password);

  Serial.println();
  Serial.println("=================================");
  Serial.println("ESP32 Line Robot + SG90 Servo");
  Serial.println("WiFi AP Started");
  Serial.println("IP: 192.168.4.1");
  Serial.print("leftTrim = ");  Serial.print(leftTrim);
  Serial.print("  rightTrim = "); Serial.println(rightTrim);
  Serial.print("leftMin = ");  Serial.print(leftMin);
  Serial.print("  rightMin = "); Serial.println(rightMin);
  Serial.println("=================================");

  /* ================================================= */
  /*                    WEB ROUTES                     */
  /* ================================================= */

  server.on("/", handleRoot);

  /* ---------- START LINE FOLLOW ---------- */
  server.on("/start", []() {
    manualMode = false;
    runRobot = true;
    clearCommands();
    server.send(200, "text/plain", "Started");
  });

  /* ---------- STOP ---------- */
  server.on("/stop", []() {
    runRobot = false;
    testRunning = false;
    clearCommands();
    stopMotors();
    server.send(200, "text/plain", "Stopped");
  });

  /* ---------- MANUAL MODE ---------- */
  server.on("/manual", []() {
    manualMode = true;
    runRobot = false;
    testRunning = false;
    clearCommands();
    stopMotors();
    server.send(200, "text/plain", "Manual Mode");
  });

  /* ---------- LINE FOLLOW MODE ---------- */
  server.on("/line", []() {
    manualMode = false;
    runRobot = false;
    testRunning = false;
    clearCommands();
    stopMotors();
    server.send(200, "text/plain", "Line Follow Mode");
  });

  /* ---------- MANUAL COMMAND ---------- */
  server.on("/cmd", []() {

    String d = server.arg("dir");
    bool state = server.arg("state").toInt();

    if (!manualMode) {
      server.send(200, "text/plain", "Manual Mode Required");
      return;
    }

    if (d == "f")      forwardCmd = state;
    else if (d == "b") backCmd = state;
    else if (d == "l") leftCmd = state;
    else if (d == "r") rightCmd = state;
    else if (d == "s") clearCommands();

    server.send(200, "text/plain", "OK");
  });

  /* ---------- SPEED ---------- */
  server.on("/speed", []() {
    if (server.hasArg("value")) {
      baseSpeed = server.arg("value").toInt();
      baseSpeed = constrain(baseSpeed, 0, 255);
    }
    server.send(200, "text/plain", "Speed Updated");
  });

  /* ---------- KP ---------- */
  server.on("/kp", []() {
    if (server.hasArg("value")) {
      Kp = server.arg("value").toFloat();
    }
    server.send(200, "text/plain", "Kp Updated");
  });

  /* ---------- SERVO ---------- */
  server.on("/servo", []() {
    if (server.hasArg("angle")) {
      setServoAngle(server.arg("angle").toInt());
    }
    server.send(200, "text/plain", "Servo Updated");
  });

  /* ---------- MOTOR CALIBRATION ---------- */
  server.on("/trim", []() {
    if (server.hasArg("left"))  leftTrim  = constrain(server.arg("left").toFloat(),  40, 100);
    if (server.hasArg("right")) rightTrim = constrain(server.arg("right").toFloat(), 40, 100);
    if (server.hasArg("lmin"))  leftMin   = constrain(server.arg("lmin").toInt(), 0, 150);
    if (server.hasArg("rmin"))  rightMin  = constrain(server.arg("rmin").toInt(), 0, 150);

    // print final values so you can copy them into the code
    Serial.print("leftTrim = ");  Serial.print(leftTrim);
    Serial.print("  rightTrim = "); Serial.print(rightTrim);
    Serial.print("  leftMin = ");  Serial.print(leftMin);
    Serial.print("  rightMin = "); Serial.println(rightMin);

    server.send(200, "text/plain", "Trim Updated");
  });

  /* ---------- SEND CURRENT SETTINGS TO THE WEB PAGE ---------- */
  server.on("/gettrim", []() {
    String j = "{\"left\":" + String(leftTrim) +
               ",\"right\":" + String(rightTrim) +
               ",\"lmin\":" + String(leftMin) +
               ",\"rmin\":" + String(rightMin) +
               ",\"speed\":" + String(baseSpeed) +
               ",\"kp\":" + String(Kp) + "}";
    server.send(200, "application/json", j);
  });

  /* ---------- SINGLE MOTOR TEST (raw PWM, to find the minimum) ---------- */
  server.on("/singletest", []() {
    String s = server.arg("side");
    manualMode = false;
    runRobot = false;
    clearCommands();
    testSide = (s == "l") ? 1 : 2;
    testRunning = true;
    testEndTime = millis() + 2000;
    server.send(200, "text/plain", "Single Test");
  });

  /* ---------- 2 SECOND FORWARD TEST ---------- */
  server.on("/fwdtest", []() {
    manualMode = false;
    runRobot = false;
    clearCommands();
    testSide = 0;
    testRunning = true;
    testEndTime = millis() + 2000;
    server.send(200, "text/plain", "Testing");
  });

  server.begin();
}


/* ================================================= */
/*                       LOOP                        */
/* ================================================= */

void loop() {

  server.handleClient();

  /* ---------- FORWARD TEST ---------- */
  if (testRunning) {
    if (millis() < testEndTime) {
      if (testSide == 0) {
        motorControl(baseSpeed, baseSpeed);       // compensated, both motors
      } else {
        rawSingleMotor(testSide, baseSpeed);      // raw PWM, one motor
      }
    } else {
      testRunning = false;
      stopMotors();
    }
    return;
  }

  /* ---------- MANUAL MODE ---------- */
  if (manualMode) {
    handleManual();
    return;
  }

  /* ---------- LINE FOLLOW MODE ---------- */
  if (runRobot) {

    int left = digitalRead(LEFT_SENSOR);
    int right = digitalRead(RIGHT_SENSOR);

    if (left == LOW && right == HIGH) {
      error = -1;
    } else if (left == HIGH && right == LOW) {
      error = 1;
    } else {
      error = 0;
    }

    float correction = Kp * error;

    int leftSpeed = baseSpeed - correction;
    int rightSpeed = baseSpeed + correction;

    motorControl(leftSpeed, rightSpeed);
  }
}
